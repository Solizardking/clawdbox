{
  "name": "solana-clawd-box-agents",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Solana blockchain agents running inside Upstash Box sandboxes via @upstash/box",
  "scripts": {
    "agent:swarm": "npx tsx agents/solana-swarm-agent.ts",
    "agent:trade": "npx tsx agents/solana-trading-agent.ts",
    "agent:screener": "npx tsx agents/solana-memecoin-screener.ts",
    "agent:portfolio": "npx tsx agents/solana-portfolio-manager.ts",
    "agent:analyst": "npx tsx agents/solana-onchain-analyst.ts",
    "agent:arb": "npx tsx agents/solana-arbitrage-scanner.ts",
    "agent:nft": "npx tsx agents/solana-nft-flipper.ts",
    "agent:perps": "npx tsx agents/solana-perps-trading-agent.ts",
    "perps:preflight": "npx tsx scripts/perps-preflight.ts",
    "solana:call-plan": "npx tsx scripts/solana-call-plan.ts",
    "arena:deepseek": "npx tsx scripts/deepseek-arena.ts",
    "batch:process": "npx tsx scripts/batch-processor.ts",
    "box:list": "npx tsx scripts/list-boxes.ts",
    "box:cleanup": "npx tsx scripts/cleanup-boxes.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "cheshire": "npx tsx agents/cheshire-terminal-agent.ts",
    "cheshire:staking": "npx tsx agents/cheshire-terminal-agent.ts staking",
    "cheshire:perps": "npx tsx agents/cheshire-terminal-agent.ts perps",
    "cheshire:caap": "npx tsx agents/cheshire-terminal-agent.ts caap",
    "cheshire:discover": "npx tsx agents/cheshire-terminal-agent.ts discover",
    "clawd-perps": "npx tsx agents/clawd-perps-box-agent.ts",
    "clawd-perps:scan": "npx tsx agents/clawd-perps-box-agent.ts --scan",
    "pump:screen": "npx tsx agents/clawd-pump-screener.ts",
    "pump:screen:top": "npx tsx agents/clawd-pump-screener.ts --top 20",
    "gateway:health": "npx tsx -e \"import {gatewayHealth,routerHealth} from './lib/clawd-gateway.js'; const [g,r] = await Promise.all([gatewayHealth(),routerHealth()]); console.log('Gateway:', g.status, '| Router:', r.status);\"",
    "router:start": "cd router && npm install && npm run dev",
    "router:deploy": "cd router && fly deploy --config fly.toml --remote-only",
    "router:logs": "fly logs --app clawd-box-router",
    "inference:check": "npx tsx -e \"import {resolveInferenceBackend} from './lib/clawd-gateway.js'; const b=resolveInferenceBackend({}); console.log('Backend:', b.backend, '\\nURL:', b.url, '\\nModel:', b.model);\"",
    "inference:test": "npx tsx --env-file=.env scripts/test-inference.ts"
  },
  "dependencies": {
    "@solana/web3.js": "^1.98.4",
    "@upstash/box": "^0.5.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
